  %32 = fadd float %22, %31, !dbg !31
  %33 = add nuw nsw i32 %24, 1, !dbg !20
  %exitcond.not = icmp eq i32 %33, %2, !dbg !20
  br i1 %exitcond.not, label %._crit_edge.loopexit, label %.lr.ph, !dbg !20

._crit_edge.loopexit:                             ; preds = %.lr.ph
  %34 = bitcast float %28 to i32, !dbg !32
  %35 = bitcast float %32 to i32, !dbg !33
  br label %._crit_edge, !dbg !34

._crit_edge:                                      ; preds = %._crit_edge.loopexit, %5
  %.lcssa4 = phi i32 [ 0, %5 ], [ %34, %._crit_edge.loopexit ], !dbg !35
  %.lcssa = phi i32 [ 0, %5 ], [ %35, %._crit_edge.loopexit ], !dbg !36
  %36 = shl i32 %6, 9, !dbg !34
  %37 = sext i32 %36 to i64, !dbg !37
  %38 = getelementptr [4 x i8], ptr addrspace(1) %1, i64 %37, !dbg !37
  %39 = zext nneg i32 %8 to i64, !dbg !37
  %40 = getelementptr [4 x i8], ptr addrspace(1) %38, i64 %39, !dbg !37
  tail call void asm sideeffect "st.global.b32 [ $1 + 0 ], { $0 };", "r,l"(i32 %.lcssa4, ptr addrspace(1) %40) #2, !dbg !32
  %41 = getelementptr i8, ptr addrspace(1) %38, i64 1024, !dbg !38
  %42 = getelementptr [4 x i8], ptr addrspace(1) %41, i64 %39, !dbg !38
  tail call void asm sideeffect "st.global.b32 [ $1 + 0 ], { $0 };", "r,l"(i32 %.lcssa, ptr addrspace(1) %42) #2, !dbg !33
  ret void, !dbg !39
