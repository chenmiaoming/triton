  %24 = phi i32 [ %33, %.lr.ph ], [ 0, %.lr.ph.preheader ]
  %25 = fcmp oge bfloat %.pn15, 8.000000e+00, !dbg !21
  %.v = select i1 %25, bfloat -1.600000e+01, bfloat 2.500000e-01, !dbg !24
