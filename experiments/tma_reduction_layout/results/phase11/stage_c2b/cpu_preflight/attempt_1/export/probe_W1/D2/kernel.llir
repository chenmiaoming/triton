.lr.ph.preheader:                                 ; preds = %5
  %20 = bitcast i16 %18 to bfloat, !dbg !19
  %21 = bitcast i16 %14 to bfloat, !dbg !16
  br label %.lr.ph, !dbg !20

.lr.ph:                                           ; preds = %.lr.ph.preheader, %.lr.ph
