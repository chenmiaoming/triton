; ModuleID = 'LLVMDialectModule'
source_filename = "LLVMDialectModule"
target datalayout = "e-p3:32:32-p4:32:32-p5:32:32-p6:32:32-p7:32:32-p101:32:32-i64:64-i128:128-i256:256-v16:16-v32:32-n16:32:64"

; Function Attrs: nounwind
define ptx_kernel void @parameter(ptr addrspace(1) %0, ptr addrspace(1) align 16 %1, i32 %2, ptr addrspace(1) nofree readnone captures(none) %3, ptr addrspace(1) nofree readnone captures(none) %4) local_unnamed_addr #0 !dbg !4 {
  %6 = tail call i32 @llvm.nvvm.read.ptx.sreg.ctaid.x(), !dbg !12
  %7 = tail call i32 @llvm.nvvm.read.ptx.sreg.tid.x(), !dbg !13
  %8 = and i32 %7, 255, !dbg !13
  %9 = shl i32 %6, 8, !dbg !14
  %10 = and i32 %9, 67108608, !dbg !14
  %11 = or disjoint i32 %10, %8, !dbg !14
  %12 = zext nneg i32 %11 to i64, !dbg !15
  %13 = getelementptr [2 x i8], ptr addrspace(1) %0, i64 %12, !dbg !15
  %14 = tail call i16 asm sideeffect "mov.u16 $0, 0x0;\0A\09ld.global.b16 { $0 }, [ $1 + 0 ];", "=c,l"(ptr addrspace(1) %13) #2, !dbg !16
  %15 = icmp sgt i32 %2, 0, !dbg !17
  br i1 %15, label %.lr.ph.preheader, label %._crit_edge, !dbg !17

.lr.ph.preheader:                                 ; preds = %5
  %16 = bitcast i16 %14 to bfloat, !dbg !16
  br label %.lr.ph, !dbg !17

.lr.ph:                                           ; preds = %.lr.ph.preheader, %.lr.ph
  %17 = phi float [ %22, %.lr.ph ], [ 0.000000e+00, %.lr.ph.preheader ]
  %.pn12 = phi bfloat [ %20, %.lr.ph ], [ %16, %.lr.ph.preheader ]
  %18 = phi i32 [ %23, %.lr.ph ], [ 0, %.lr.ph.preheader ]
  %19 = fcmp oge bfloat %.pn12, 8.000000e+00, !dbg !18
  %.v = select i1 %19, bfloat -1.600000e+01, bfloat 2.500000e-01, !dbg !21
  %20 = fadd bfloat %.pn12, %.v, !dbg !21
  %21 = fpext bfloat %20 to float, !dbg !22
  %22 = fadd float %17, %21, !dbg !23
  %23 = add nuw nsw i32 %18, 1, !dbg !17
  %exitcond.not = icmp eq i32 %23, %2, !dbg !17
  br i1 %exitcond.not, label %._crit_edge.loopexit, label %.lr.ph, !dbg !17

._crit_edge.loopexit:                             ; preds = %.lr.ph
  %24 = bitcast float %22 to i32, !dbg !24
  br label %._crit_edge, !dbg !25

._crit_edge:                                      ; preds = %._crit_edge.loopexit, %5
  %.lcssa = phi i32 [ 0, %5 ], [ %24, %._crit_edge.loopexit ], !dbg !26
  %25 = sext i32 %9 to i64, !dbg !25
  %26 = getelementptr [4 x i8], ptr addrspace(1) %1, i64 %25, !dbg !25
  %27 = zext nneg i32 %8 to i64, !dbg !25
  %28 = getelementptr [4 x i8], ptr addrspace(1) %26, i64 %27, !dbg !25
  tail call void asm sideeffect "st.global.b32 [ $1 + 0 ], { $0 };", "r,l"(i32 %.lcssa, ptr addrspace(1) %28) #2, !dbg !24
  ret void, !dbg !27
}

