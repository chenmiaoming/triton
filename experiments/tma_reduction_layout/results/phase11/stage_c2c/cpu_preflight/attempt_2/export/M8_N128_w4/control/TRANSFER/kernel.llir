  %13 = lshr i32 %12, 5, !dbg !14
  %14 = icmp eq i32 %13, 0, !dbg !14
  %15 = tail call { i32, i1 } @llvm.nvvm.elect.sync(i32 -1), !dbg !14
  %16 = extractvalue { i32, i1 } %15, 1, !dbg !14
  %17 = and i1 %14, %16, !dbg !14
  tail call void asm sideeffect "@$0 mbarrier.init.shared::cta.b64 [$1], 1;", "b,r"(i1 %17, ptr addrspace(3) getelementptr (i8, ptr addrspace(3) @global_smem, i32 2048)) #6, !dbg !14
  %18 = icmp sgt i32 %8, 0, !dbg !15
  br i1 %18, label %.lr.ph, label %._crit_edge, !dbg !15

.lr.ph:                                           ; preds = %11
  %19 = tail call i32 @llvm.nvvm.read.ptx.sreg.ctaid.x(), !dbg !16
  %20 = lshr i32 %19, 6, !dbg !17
  %21 = and i32 %12, 127, !dbg !18
  %22 = icmp eq i32 %21, 0
  %23 = shl i32 %19, 7
  %24 = and i32 %23, 8064
  %25 = icmp samesign ult i32 %21, 64
  %26 = and i32 %12, 63
  %27 = shl nuw nsw i32 %12, 3
  %28 = and i32 %27, 512
  %29 = getelementptr [2 x i8], ptr addrspace(3) @global_smem, i32 %28
  %30 = getelementptr [2 x i8], ptr addrspace(3) %29, i32 %26
  %31 = mul i32 %8, %19
  %32 = zext nneg i32 %21 to i64
  %invariant.gep = getelementptr [4 x i8], ptr addrspace(1) %7, i64 %32, !dbg !15
  %33 = zext nneg i32 %8 to i64, !dbg !15
  %wide.trip.count = zext nneg i32 %8 to i64, !dbg !15
  br label %34, !dbg !15

34:                                               ; preds = %.lr.ph, %57
  %indvars.iv = phi i64 [ 0, %.lr.ph ], [ %indvars.iv.next, %57 ]
  %35 = trunc i64 %indvars.iv to i32, !dbg !19
  %36 = add i32 %20, %35, !dbg !19
  %37 = srem i32 %36, 1024, !dbg !19
  %38 = shl nsw i32 %37, 3, !dbg !20
  call void @llvm.nvvm.barrier.cta.sync.aligned.all(i32 0), !dbg !21
  call void asm sideeffect "@$0 mbarrier.arrive.expect_tx.shared::cta.b64 _, [$1], 2048;", "b,r"(i1 %22, ptr addrspace(3) getelementptr (i8, ptr addrspace(3) @global_smem, i32 2048)) #6, !dbg !21
  call void @llvm.nvvm.fence.proxy.async.shared_cta(), !dbg !22
  %39 = call i32 @llvm.nvvm.shfl.sync.idx.i32(i32 -1, i32 %13, i32 0, i32 31), !dbg !22
  %40 = call { i32, i1 } @llvm.nvvm.elect.sync(i32 -1), !dbg !22
  %41 = extractvalue { i32, i1 } %40, 1, !dbg !22
  %42 = and i1 %25, %41, !dbg !22
  %43 = and i32 %39, 1, !dbg !22
  %.idx = shl nuw nsw i32 %43, 10, !dbg !22
  %44 = getelementptr i8, ptr addrspace(3) @global_smem, i32 %.idx, !dbg !22
  %45 = shl nuw nsw i32 %43, 6, !dbg !22
  %46 = or disjoint i32 %45, %24, !dbg !22
  call void asm sideeffect "@$0 cp.async.bulk.tensor.3d.shared::cta.global.mbarrier::complete_tx::bytes [$1], [$2, {$3, $4, $5}], [$6];", "b,r,l,r,r,r,r"(i1 %42, ptr addrspace(3) %44, ptr nonnull %0, i32 %46, i32 %38, i32 0, ptr addrspace(3) getelementptr (i8, ptr addrspace(3) @global_smem, i32 2048)) #6, !dbg !22
  %47 = trunc nuw nsw i64 %indvars.iv to i32, !dbg !23
  %48 = and i32 %47, 1, !dbg !23
  call void asm sideeffect "\0A{\0A\09.reg .pred complete;\0A\09waitLoop:\0A\09mbarrier.try_wait.parity.shared::cta.b64 complete, [$0], $1;\0A\09@!complete bra.uni waitLoop;\0A}\0A", "r,r"(ptr addrspace(3) getelementptr (i8, ptr addrspace(3) @global_smem, i32 2048), i32 %48) #6, !dbg !24
  %49 = load bfloat, ptr addrspace(3) %30, align 2, !dbg !25
  %50 = fpext bfloat %49 to float, !dbg !25
  %51 = add i32 %31, %47, !dbg !26
  %52 = shl i32 %51, 7, !dbg !27
  %53 = sext i32 %52 to i64, !dbg !28
  %gep = getelementptr [4 x i8], ptr addrspace(1) %invariant.gep, i64 %53, !dbg !28
  %54 = bitcast float %50 to i32, !dbg !29
  call void asm sideeffect "st.global.b32 [ $1 + 0 ], { $0 };", "r,l"(i32 %54, ptr addrspace(1) %gep) #6, !dbg !29
  %indvars.iv.next = add nuw nsw i64 %indvars.iv, 1, !dbg !30
  %55 = icmp samesign ult i64 %indvars.iv.next, %33, !dbg !30
  br i1 %55, label %56, label %57, !dbg !31

56:                                               ; preds = %34
  call void @llvm.nvvm.barrier.cta.sync.aligned.all(i32 0), !dbg !32
  br label %57, !dbg !31

57:                                               ; preds = %56, %34
  %exitcond.not = icmp eq i64 %indvars.iv.next, %wide.trip.count, !dbg !15
  br i1 %exitcond.not, label %._crit_edge, label %34, !dbg !15

._crit_edge:                                      ; preds = %57, %11
  call void @llvm.nvvm.barrier.cta.sync.aligned.all(i32 0), !dbg !33
  %58 = call { i32, i1 } @llvm.nvvm.elect.sync(i32 -1), !dbg !33
  %59 = extractvalue { i32, i1 } %58, 1, !dbg !33
  %60 = and i1 %14, %59, !dbg !33
  call void asm sideeffect "@$0 mbarrier.inval.shared::cta.b64 [$1];", "b,r"(i1 %60, ptr addrspace(3) getelementptr (i8, ptr addrspace(3) @global_smem, i32 2048)) #6, !dbg !33
  ret void, !dbg !34
}

