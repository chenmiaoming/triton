  %48 = zext nneg i32 %8 to i64, !dbg !15
  %wide.trip.count = zext nneg i32 %8 to i64, !dbg !15
  br label %49, !dbg !15

49:                                               ; preds = %.lr.ph, %86
  %indvars.iv = phi i64 [ 0, %.lr.ph ], [ %indvars.iv.next, %86 ]
  %50 = trunc i64 %indvars.iv to i32, !dbg !19
  %51 = add i32 %20, %50, !dbg !19
  %52 = srem i32 %51, 1024, !dbg !19
  %53 = shl nsw i32 %52, 3, !dbg !20
  call void @llvm.nvvm.barrier.cta.sync.aligned.all(i32 0), !dbg !21
  call void asm sideeffect "@$0 mbarrier.arrive.expect_tx.shared::cta.b64 _, [$1], 2048;", "b,r"(i1 %22, ptr addrspace(3) getelementptr (i8, ptr addrspace(3) @global_smem, i32 2048)) #7, !dbg !21
  call void @llvm.nvvm.fence.proxy.async.shared_cta(), !dbg !22
  %54 = call i32 @llvm.nvvm.shfl.sync.idx.i32(i32 -1, i32 %13, i32 0, i32 31), !dbg !22
