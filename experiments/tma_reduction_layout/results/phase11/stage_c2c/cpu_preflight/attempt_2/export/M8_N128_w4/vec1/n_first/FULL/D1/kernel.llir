  %83 = bitcast float %79 to i32, !dbg !35
  call void asm sideeffect "st.global.b32 [ $1 + 0 ], { $0 };", "r,l"(i32 %83, ptr addrspace(1) %gep) #7, !dbg !35
  %indvars.iv.next = add nuw nsw i64 %indvars.iv, 1, !dbg !36
  %84 = icmp samesign ult i64 %indvars.iv.next, %48, !dbg !36
  br i1 %84, label %85, label %86, !dbg !37

85:                                               ; preds = %49
  call void @llvm.nvvm.barrier.cta.sync.aligned.all(i32 0), !dbg !38
