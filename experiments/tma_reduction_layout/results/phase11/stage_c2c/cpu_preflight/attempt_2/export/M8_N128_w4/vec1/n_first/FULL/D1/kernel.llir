  %88 = extractvalue { i32, i1 } %87, 1, !dbg !39
  %89 = and i1 %14, %88, !dbg !39
  call void asm sideeffect "@$0 mbarrier.inval.shared::cta.b64 [$1];", "b,r"(i1 %89, ptr addrspace(3) getelementptr (i8, ptr addrspace(3) @global_smem, i32 2048)) #7, !dbg !39
  ret void, !dbg !40
