  %23 = shl i32 %19, 7
  %24 = and i32 %23, 8064
  %25 = icmp samesign ult i32 %21, 64
  %26 = shl nuw nsw i32 %12, 1
  %27 = and i32 %26, 126
  %28 = shl nuw nsw i32 %12, 4
  %29 = and i32 %28, 1024
  %30 = or disjoint i32 %29, %27
