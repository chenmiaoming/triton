  tail call void asm sideeffect "@$0 mbarrier.init.shared::cta.b64 [$1], 1;", "b,r"(i1 %17, ptr addrspace(3) getelementptr (i8, ptr addrspace(3) @global_smem, i32 2048)) #7, !dbg !14
  %18 = icmp sgt i32 %8, 0, !dbg !15
