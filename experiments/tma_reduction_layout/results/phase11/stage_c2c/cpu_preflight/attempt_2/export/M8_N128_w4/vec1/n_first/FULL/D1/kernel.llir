  call void asm sideeffect "@$0 cp.async.bulk.tensor.3d.shared::cta.global.mbarrier::complete_tx::bytes [$1], [$2, {$3, $4, $5}], [$6];", "b,r,l,r,r,r,r"(i1 %57, ptr addrspace(3) %59, ptr nonnull %0, i32 %61, i32 %53, i32 0, ptr addrspace(3) getelementptr (i8, ptr addrspace(3) @global_smem, i32 2048)) #7, !dbg !22
  %62 = trunc nuw nsw i64 %indvars.iv to i32, !dbg !23
  %63 = and i32 %62, 1, !dbg !23
  call void asm sideeffect "\0A{\0A\09.reg .pred complete;\0A\09waitLoop:\0A\09mbarrier.try_wait.parity.shared::cta.b64 complete, [$0], $1;\0A\09@!complete bra.uni waitLoop;\0A}\0A", "r,r"(ptr addrspace(3) getelementptr (i8, ptr addrspace(3) @global_smem, i32 2048), i32 %63) #7, !dbg !24
