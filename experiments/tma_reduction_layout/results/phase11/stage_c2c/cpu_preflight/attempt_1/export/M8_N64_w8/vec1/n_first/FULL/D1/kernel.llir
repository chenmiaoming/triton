; ModuleID = 'LLVMDialectModule'
source_filename = "LLVMDialectModule"
target datalayout = "e-p3:32:32-p4:32:32-p5:32:32-p6:32:32-p7:32:32-p101:32:32-i64:64-i128:128-i256:256-v16:16-v32:32-n16:32:64"

@global_smem = external addrspace(3) global [0 x i8], align 16

; Function Attrs: nounwind
define ptx_kernel void @streaming(ptr byval([128 x i8]) align 64 "nvvm.grid_constant" %0, i32 %1, i32 %2, i32 %3, i64 %4, i64 %5, i64 %6, ptr addrspace(1) align 16 %7, i32 %8, ptr addrspace(1) nofree readnone captures(none) %9, ptr addrspace(1) nofree readnone captures(none) %10) local_unnamed_addr #0 !dbg !4 {
  %12 = tail call i32 @llvm.nvvm.read.ptx.sreg.tid.x(), !dbg !14
  %13 = icmp samesign ult i32 %12, 32, !dbg !14
  %14 = tail call { i32, i1 } @llvm.nvvm.elect.sync(i32 -1), !dbg !14
  %15 = extractvalue { i32, i1 } %14, 1, !dbg !14
  %16 = and i1 %13, %15, !dbg !14
  tail call void asm sideeffect "@$0 mbarrier.init.shared::cta.b64 [$1], 1;", "b,r"(i1 %16, ptr addrspace(3) getelementptr (i8, ptr addrspace(3) @global_smem, i32 2048)) #8, !dbg !14
  %17 = icmp sgt i32 %8, 0, !dbg !15
  br i1 %17, label %.lr.ph, label %._crit_edge, !dbg !15

.lr.ph:                                           ; preds = %11
  %18 = tail call i32 @llvm.nvvm.read.ptx.sreg.ctaid.x(), !dbg !16
  %19 = lshr i32 %18, 7, !dbg !17
  %20 = and i32 %12, 63, !dbg !18
  %21 = and i32 %12, 255, !dbg !18
  %22 = icmp eq i32 %21, 0
  %23 = shl i32 %18, 6
  %24 = and i32 %23, 8128
  %25 = icmp samesign ult i32 %21, 32
  %26 = shl nuw nsw i32 %21, 1
  %27 = and i32 %12, 192
  %28 = lshr exact i32 %27, 2
  %29 = xor i32 %26, %28
  %30 = getelementptr inbounds nuw i8, ptr addrspace(3) @global_smem, i32 %29
  %31 = xor i32 %29, 576
  %32 = getelementptr inbounds nuw i8, ptr addrspace(3) @global_smem, i32 %31
  %33 = shl nuw nsw i32 %21, 2
  %34 = lshr exact i32 %27, 4
  %35 = xor i32 %33, %34
  %36 = getelementptr inbounds nuw i8, ptr addrspace(3) getelementptr (i8, ptr addrspace(3) @global_smem, i32 1024), i32 %35
  %37 = shl nuw nsw i32 %12, 8
  %38 = and i32 %37, 768
  %39 = shl nuw nsw i32 %20, 2
  %40 = xor i32 %39, %34
  %41 = getelementptr inbounds nuw i8, ptr addrspace(3) getelementptr (i8, ptr addrspace(3) @global_smem, i32 1024), i32 %38
  %42 = getelementptr inbounds nuw i8, ptr addrspace(3) %41, i32 %40
  %43 = shl nuw nsw i32 %12, 2
  %44 = and i32 %43, 240
  %45 = getelementptr inbounds nuw i8, ptr addrspace(3) getelementptr (i8, ptr addrspace(3) @global_smem, i32 1024), i32 %44
  %46 = getelementptr inbounds nuw i8, ptr addrspace(3) %45, i32 %34
  %47 = getelementptr inbounds nuw i8, ptr addrspace(3) getelementptr (i8, ptr addrspace(3) @global_smem, i32 1024), i32 %39
  %48 = mul i32 %8, %18
  %49 = zext nneg i32 %20 to i64
  %invariant.gep = getelementptr [4 x i8], ptr addrspace(1) %7, i64 %49, !dbg !15
  %50 = icmp eq i32 %27, 0
  %51 = zext nneg i32 %8 to i64, !dbg !15
  %wide.trip.count = zext nneg i32 %8 to i64, !dbg !15
  br label %52, !dbg !15

52:                                               ; preds = %.lr.ph, %81
  %indvars.iv = phi i64 [ 0, %.lr.ph ], [ %indvars.iv.next, %81 ]
  %53 = trunc i64 %indvars.iv to i32, !dbg !19
  %54 = add i32 %19, %53, !dbg !19
  %55 = srem i32 %54, 1024, !dbg !19
  %56 = shl nsw i32 %55, 3, !dbg !20
  call void @llvm.nvvm.barrier.cta.sync.aligned.all(i32 0), !dbg !21
  call void asm sideeffect "@$0 mbarrier.arrive.expect_tx.shared::cta.b64 _, [$1], 1024;", "b,r"(i1 %22, ptr addrspace(3) getelementptr (i8, ptr addrspace(3) @global_smem, i32 2048)) #8, !dbg !21
  call void @llvm.nvvm.fence.proxy.async.shared_cta(), !dbg !22
  %57 = call { i32, i1 } @llvm.nvvm.elect.sync(i32 -1), !dbg !22
  %58 = extractvalue { i32, i1 } %57, 1, !dbg !22
  %59 = and i1 %25, %58, !dbg !22
  call void asm sideeffect "@$0 cp.async.bulk.tensor.3d.shared::cta.global.mbarrier::complete_tx::bytes [$1], [$2, {$3, $4, $5}], [$6];", "b,r,l,r,r,r,r"(i1 %59, ptr addrspace(3) @global_smem, ptr nonnull %0, i32 %24, i32 %56, i32 0, ptr addrspace(3) getelementptr (i8, ptr addrspace(3) @global_smem, i32 2048)) #8, !dbg !22
  %60 = trunc nuw nsw i64 %indvars.iv to i32, !dbg !23
  %61 = and i32 %60, 1, !dbg !23
  call void asm sideeffect "\0A{\0A\09.reg .pred complete;\0A\09waitLoop:\0A\09mbarrier.try_wait.parity.shared::cta.b64 complete, [$0], $1;\0A\09@!complete bra.uni waitLoop;\0A}\0A", "r,r"(ptr addrspace(3) getelementptr (i8, ptr addrspace(3) @global_smem, i32 2048), i32 %61) #8, !dbg !24
  %62 = load bfloat, ptr addrspace(3) %30, align 2, !dbg !25
  %63 = load bfloat, ptr addrspace(3) %32, align 2, !dbg !25
  %64 = call bfloat @llvm.maxnum.bf16(bfloat %62, bfloat %63), !dbg !26
  %65 = fpext bfloat %64 to float, !dbg !26
  store float %65, ptr addrspace(3) %36, align 4, !dbg !29
  call void @llvm.nvvm.barrier.cta.sync.aligned.all(i32 0), !dbg !29
  %66 = load i32, ptr addrspace(3) %42, align 4, !dbg !29
  %67 = bitcast i32 %66 to float, !dbg !29
  %68 = call i32 @llvm.nvvm.shfl.sync.bfly.i32(i32 -1, i32 %66, i32 2, i32 31), !dbg !29
  %69 = bitcast i32 %68 to float, !dbg !29
  %70 = call float @llvm.maxnum.f32(float %67, float %69), !dbg !26
  %71 = bitcast float %70 to i32, !dbg !29
  %72 = call i32 @llvm.nvvm.shfl.sync.bfly.i32(i32 -1, i32 %71, i32 1, i32 31), !dbg !29
  %73 = bitcast i32 %72 to float, !dbg !29
  %74 = call float @llvm.maxnum.f32(float %70, float %73), !dbg !26
  call void @llvm.nvvm.barrier.cta.sync.aligned.all(i32 0), !dbg !29
  store float %74, ptr addrspace(3) %46, align 4, !dbg !29
  call void @llvm.nvvm.barrier.cta.sync.aligned.all(i32 0), !dbg !29
  %75 = load i32, ptr addrspace(3) %47, align 4, !dbg !29
  %76 = add i32 %48, %60, !dbg !32
  %77 = shl i32 %76, 6, !dbg !33
  %78 = sext i32 %77 to i64, !dbg !34
  %gep = getelementptr [4 x i8], ptr addrspace(1) %invariant.gep, i64 %78, !dbg !34
  call void asm sideeffect "@$2 st.global.b32 [ $1 + 0 ], { $0 };", "r,l,b"(i32 %75, ptr addrspace(1) %gep, i1 %50) #8, !dbg !35
  %indvars.iv.next = add nuw nsw i64 %indvars.iv, 1, !dbg !36
  %79 = icmp samesign ult i64 %indvars.iv.next, %51, !dbg !36
  br i1 %79, label %80, label %81, !dbg !37

80:                                               ; preds = %52
  call void @llvm.nvvm.barrier.cta.sync.aligned.all(i32 0), !dbg !38
  br label %81, !dbg !37

81:                                               ; preds = %80, %52
  %exitcond.not = icmp eq i64 %indvars.iv.next, %wide.trip.count, !dbg !15
  br i1 %exitcond.not, label %._crit_edge, label %52, !dbg !15

._crit_edge:                                      ; preds = %81, %11
  %82 = call { i32, i1 } @llvm.nvvm.elect.sync(i32 -1), !dbg !39
  %83 = extractvalue { i32, i1 } %82, 1, !dbg !39
  %84 = and i1 %13, %83, !dbg !39
  call void asm sideeffect "@$0 mbarrier.inval.shared::cta.b64 [$1];", "b,r"(i1 %84, ptr addrspace(3) getelementptr (i8, ptr addrspace(3) @global_smem, i32 2048)) #8, !dbg !39
  ret void, !dbg !40
}

